# .env.template
# Safe example environment file for local development.
# Copy this to `.env` and fill in real secrets locally. Do NOT commit `.env`.
# The repository's .gitignore already ignores `.env` and `.env copy`.

# Azure / Cloud keys
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# GitHub / CI
GITHUB_PAT=

# Databases / services
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379

# App configuration
NODE_ENV=development
PORT=3000

# Optional 3rd-party integrations (placeholders)
TEG_SERVICE_API_KEY=
ANALYTICS_WRITE_KEY=

# Notes:
# - Replace placeholder values with real credentials in your local `.env` file.
# - Never paste real secrets into PR descriptions, issues, or public chat.
# - If a secret is accidentally committed, rotate it immediately and follow the repo's secret-removal procedure.
